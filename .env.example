# Copie ce fichier en ".env" et remplis tes propres identifiants.
# .env est ignoré par git (voir .gitignore) — ne partage jamais ce fichier rempli.

# Telegram — obtenir un token via @BotFather, le chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optionnel, fonctionnalité historique conservée)
DISCORD_WEBHOOK_URL=
